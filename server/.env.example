# Port for server (default: 3000)
PORT=3000

# Set MONGODB_URI, or configure DB_SERVER + DB_USER + DB_PASS below.
MONGODB_URI=
DB_SERVER=
DB_USER=
DB_PASS=
DB_DATABASE=shoppingonline

# Use a long, unique secret. Never commit the populated .env file.
JWT_SECRET=
JWT_EXPIRES=3600000

# Gmail SMTP credentials; use a Google App Password for EMAIL_PASS.
EMAIL_USER=
EMAIL_PASS=
# Optional sender address; defaults to EMAIL_USER.
EMAIL_FROM=

# Public base URL used in activation links.
CLIENT_URL=http://localhost:3001

# Development-only; defaults to false. Ignored when NODE_ENV=production.
DEV_AUTO_ACTIVATE=false
